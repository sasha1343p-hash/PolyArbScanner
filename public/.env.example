# .env.example — Конфигурация PolyArb Scanner
# Скопируйте в .env и настройте под себя

# API endpoints (по умолчанию)
POLYMARKET_API=https://gamma-api.polymarket.com/events
BINANCE_API=https://api.binance.com/api/v3/ticker/price

# Порог арбитража (0.0 - 1.0)
DEFAULT_THRESHOLD=0.15

# Путь к базе данных
DB_PATH=markets.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
